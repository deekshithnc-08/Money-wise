{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "regions": ["bom1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    { "source": "/:path*", "destination": "/api/index?route=/:path*" }
  ]
}
