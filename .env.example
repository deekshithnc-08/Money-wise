# Copy to .env; never commit real credentials.
PUBLIC_URL=http://localhost:8000
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=data/app.sqlite3
PROGRAMME_BATCH=Upcoming cohort
PROGRAMME_SCHEDULE=Dates to be announced
PROGRAMME_VENUE=Venue to be announced
PROGRAMME_FEE_LABEL=Fee shared before confirmation
# Optional: when all three are set, referral generation requires SMS verification.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Vercel: connect a Turso Cloud database (persistent, remote SQLite).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
